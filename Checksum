import socket

def calculate_checksum(data):
    if len(data) % 2 != 0:
        data += b'\x00'

    s = 0

    for i in range(0, len(data), 2):
        w = (data[i] << 8) + data[i + 1]
        s += w
        s = (s >> 16) + (s & 0xFFFF)

    s += s >> 16

    return ~s & 0xFFFF


HOST = "192.168.31.15"
PORT = 8000

client = socket.socket()
client.connect((HOST, PORT))

message = b"Hello Server"

checksum = calculate_checksum(message)

packet = message + checksum.to_bytes(
    2,
    byteorder="big"
)

client.sendall(packet)

print(
    f"Sent message: {message.decode()} "
    f"with checksum: {checksum}"
)

client.close()
