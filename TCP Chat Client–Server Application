import socket

HOST = "127.0.0.1"
PORT = 3000

server = socket.socket()
server.bind((HOST, PORT))
server.listen(5)

print("Server is listening for connection")

conn, addr = server.accept()

print("Connected to:", addr)

while True:
    data = conn.recv(1024).decode()

    if not data:
        break

    print("Client message:", data)

    server_data = input("Enter data to send to client: ")

    if server_data == "exit":
        break

    conn.send(server_data.encode())

conn.close()
server.close()

