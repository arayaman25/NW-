import socket

HOST = "127.0.0.1"
PORT = 3000

client = socket.socket()
client.connect((HOST, PORT))

while True:
    client_data = input("Enter data to send to server: ")

    if client_data == "exit":
        break

    client.send(client_data.encode())

    reply = client.recv(1024).decode()
    print("Server's reply:", reply)

client.close()
